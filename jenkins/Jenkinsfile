pipeline {
agent any

```
environment {
    AWS_REGION = "ap-south-1"
    AWS_ACCOUNT_ID = "042775549160"
    ECR_REPO = "linux-monitoring-system"
}

stages {

    stage('Checkout') {
        steps {
            checkout scm
        }
    }

    stage('Verify Tools') {
        steps {
            sh '''
            docker --version
            aws --version
            kubectl version --client
            '''
        }
    }

    stage('Build Docker Image') {
        steps {
            sh '''
            docker build -t linux-monitor-system -f docker/Dockerfile .
            '''
        }
    }

    stage('Login To ECR') {
        steps {
            sh '''
            aws ecr get-login-password --region $AWS_REGION | \
            docker login --username AWS --password-stdin \
            $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
            '''
        }
    }

    stage('Push To ECR') {
        steps {
            sh '''
            docker tag linux-monitor-system:latest \
            $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest

            docker push \
            $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com/$ECR_REPO:latest
            '''
        }
    }

    stage('Deploy To Kubernetes') {
        steps {
            sh '''
            export KUBECONFIG=/var/jenkins_home/.kube/config

            kubectl rollout restart deployment/linux-monitoring
            kubectl rollout status deployment/linux-monitoring
            '''
        }
    }

    stage('Verify Deployment') {
        steps {
            sh '''
            export KUBECONFIG=/var/jenkins_home/.kube/config
            kubectl get pods
            '''
        }
    }
}

post {
    success {
        echo 'Pipeline completed successfully!'
    }

    failure {
        echo 'Pipeline failed!'
    }
}
```

}
