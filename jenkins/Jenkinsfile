pipeline {

 agent any

 stages {

  stage('Checkout') {
   steps {
    checkout scm
   }
  }

  stage('Smoke Test') {
   steps {
    sh 'make test'
   }
  }

  stage('Build') {
   steps {
    sh 'make build'
   }
  }

 stage('Health Check') {
  steps {
   sh 'bash scripts/health-check.sh'
  }
 }
  stage('Deploy') {
   steps {
    sh 'make up'
   }
  }

 }

}
